<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.bigsolevibes.imagegen</string>

    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/node</string>
        <string>/Users/davidgeer/claude/bigsolevibes-web/scripts/image-gen.js</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/davidgeer/claude/bigsolevibes-web</string>

    <!-- Runs every night at midnight — picks up -prompt.txt files from Ready to Post/ -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>0</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/davidgeer/claude/bigsolevibes-web/logs/image-gen.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/davidgeer/claude/bigsolevibes-web/logs/image-gen-error.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>HOME</key>
        <string>/Users/davidgeer</string>
    </dict>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
