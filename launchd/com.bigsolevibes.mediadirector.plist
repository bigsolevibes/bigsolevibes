<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.bigsolevibes.mediadirector</string>

    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/node</string>
        <string>/Users/davidgeer/claude/bigsolevibes-web/scripts/media-director.js</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/davidgeer/claude/bigsolevibes-web</string>

    <!-- Runs every night at 11:00PM. Script computes tomorrow's day automatically. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>23</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/davidgeer/claude/bigsolevibes-web/logs/media-director.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/davidgeer/claude/bigsolevibes-web/logs/media-director-error.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>HOME</key>
        <string>/Users/davidgeer</string>
    </dict>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
