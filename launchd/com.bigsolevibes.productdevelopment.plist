<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.bigsolevibes.productdevelopment</string>

    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/node</string>
        <string>/Users/davidgeer/claude/bigsolevibes-web/scripts/product-development.js</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/davidgeer/claude/bigsolevibes-web</string>

    <!-- Runs every Sunday at 10:00PM — before social-listening (11PM) and media-director (11:30PM) -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>0</integer>
        <key>Hour</key>
        <integer>22</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/davidgeer/claude/bigsolevibes-web/logs/product-development.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/davidgeer/claude/bigsolevibes-web/logs/product-development-error.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>HOME</key>
        <string>/Users/davidgeer</string>
    </dict>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
