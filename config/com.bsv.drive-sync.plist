<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.bsv.drive-sync</string>

  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/node</string>
    <string>/Users/davidgeer/claude/bigsolevibes-web/scripts/drive-sync.js</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/davidgeer/claude/bigsolevibes-web</string>

  <key>StartInterval</key>
  <integer>300</integer>

  <key>StandardOutPath</key>
  <string>/Users/davidgeer/claude/bigsolevibes-web/logs/drive-sync-error.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/davidgeer/claude/bigsolevibes-web/logs/drive-sync-error.log</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>HOME</key>
    <string>/Users/davidgeer</string>
  </dict>

  <key>KeepAlive</key>
  <false/>

  <key>RunAtLoad</key>
  <true/>
</dict>
</plist>
