<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.bsv.sole-report-agent</string>

  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/node</string>
    <string>/Users/davidgeer/claude/bigsolevibes-web/scripts/blog-agent.js</string>
    <string>--sole-report</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/davidgeer/claude/bigsolevibes-web</string>

  <!-- Runs Sunday 11:30 PM — after media-director writes the Saturday brief; article live Monday -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key>
    <integer>0</integer>
    <key>Hour</key>
    <integer>23</integer>
    <key>Minute</key>
    <integer>30</integer>
  </dict>

  <key>StandardOutPath</key>
  <string>/Users/davidgeer/claude/bigsolevibes-web/logs/sole-report-agent.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/davidgeer/claude/bigsolevibes-web/logs/sole-report-agent.log</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>HOME</key>
    <string>/Users/davidgeer</string>
  </dict>

  <key>KeepAlive</key>
  <false/>

  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
