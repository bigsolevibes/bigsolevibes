# dependencies
node_modules/

# Next.js build output
.next/
out/

# environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Google OAuth credentials
client_secret.json

# misc
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Vercel
.vercel

# Generated brief files (local pipeline artifacts)
posts/briefs/*.txt

# Pipeline logs (local only — never commit)
logs/

# Credential and token files — never commit
config/youtube-credentials.json
config/youtube-token.json
config/tiktok-token.json
config/.youtube-new-credentials.txt
gen-lang-client*.json

# Dashboard — local only, never deploy to CF Pages
# Narrowed to the NextAuth catch-all specifically (not all of app/api/auth/)
# so app/api/auth/tiktok/callback/ can still be tracked and deployed.
# NOTE: square brackets are a glob character class in gitignore syntax, so
# the unescaped form below never actually matched this literal directory
# name — confirmed via `git check-ignore`, it was untracked-but-not-ignored
# the whole time. Escaped so it actually takes effect.
app/api/auth/\[...nextauth\]/
app/api/dashboard/
app/dashboard/
lib/auth.ts
lib/dashboard/
middleware.ts
components/dashboard/

# Build/editor junk — never commit
*.bak
*.tmp
tsconfig.tsbuildinfo

# Processed pipeline media (both local staging and public/ mirror) — never
# tracked in git by design. Per commit 495addb5 (2026-05-27, "remove git
# push from resize-post — Drive/R2 are authoritative"): Google Drive holds
# the source assets and Cloudflare R2 serves the public Instagram URL;
# distribute.js posts from local disk + R2, not from a Next.js-served path.
# Same "local working data" category as logs/.
posts/output/
public/posts/output/
